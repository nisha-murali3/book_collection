<!-- update a book page - mostly empty, title field and link back -->
<!-- Include the same four fields as the new-book page, and a submit button titled "Update book" -->

<h1>Update Book</h1>

<%= form_with model: @book do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <%= form.submit "Update Book" %>
<% end %>

<%= link_to "Back to Home", root_path %>