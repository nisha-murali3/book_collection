<!-- Render a form bound to a new, unsaved @book. -->
<!--Include a text field for title, with a label. -->
<!--Include a text field for author, with a label. -->
<!--Include a number field for price (allowing decimals), with a label. -->
<!--Include a date dropdown (year/month/day selects) for published_date, with a label. -->
<!--Include a submit button labeled "Create Book". -->
<!--Render a link back to the home page. -->

<h1>Add a Book</h1>

<%= form_with model: @book do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :author %>
    <%= form.text_field :author %>
  </div>
  <div>
    <%= form.label :price %>
    <%= form.number_field :price, step: 0.01 %>
  </div>
  <div>
    <%= form.label :published_date %>
    <%= form.date_select :published_date %>
  </div>
  <%= form.submit "Create Book" %>
<% end %>

<%= link_to "Back to Home", root_path %>

