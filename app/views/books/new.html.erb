<!-- adding a book page - currently in html with a title field, a button for creating a book, and a link back to home -->

<h1>Add a Book</h1>

<%= form_with model: @book do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <%= form.submit "Create Book" %>
<% end %>

<%= link_to "Back to Home", root_path %>

