
<!--  Render links to the Books index, Users index, and New User Book page. -->
<!-- Render a link to create a new user_book. and a table listing every user_book. -->
<!--   For each row, show the associated user's username, book title, and show/edit/delete links. -->
<p style="color: green"><%= notice %></p>

<h1>User books</h1>

<p>
  <%= link_to "All Books", books_path %> |
  <%= link_to "All Users", users_path %> |
  <%= link_to "New User Book", new_user_book_path %>
</p>

<div id="user_books">
  <table>
    <thead>
      <tr>
        <th>User</th>   
        <th>Book</th>   
        <th colspan="3"></th>
      </tr>
    </thead>

    <tbody>
      <% @user_books.each do |user_book| %>
        <tr>
          <td><%= user_book.user&.username %></td>  <%# NEW: shows username, not user_id %>
          <td><%= user_book.book&.title %></td>      <%# NEW: shows title, not book_id %>
          <td><%= link_to "Show", user_book %></td>
          <td><%= link_to "Edit", edit_user_book_path(user_book) %></td>
          <td><%= link_to "Destroy", user_book, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>